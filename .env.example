# ─────────────────────────────────────────────────────────────────────────────
# Walaa — environment template. Copy to `.env` and fill in real values.
# NEVER commit a populated .env (see .gitignore). CLAUDE.md §7.6.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# v3: local SQLite file (CLAUDE_v3.md §5.1). Relative paths resolve from
# apps/api/prisma. In production this points at the OS app-data directory for
# the Windows Service account (§12.3).
DATABASE_URL="file:./walaa.db"

# ── API service ─────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated origins allowed to call the API.
#  tauri.localhost — the Tauri 2 webview origin (the manager desktop app)
#  localhost:5173  — the Vite dev server for the manager desktop UI
#  localhost:5174  — the Vite dev server for the Loyalty Station
#                    (in production the Station is served BY the API, same origin)
#  localhost:4000  — the Loyalty Station, which the API serves itself
# A LAN deployment may need the manager machine's own address added here.
API_CORS_ORIGINS="http://tauri.localhost,https://tauri.localhost,http://localhost:5173,http://localhost:5174,http://localhost:4000"
LOG_LEVEL=info

# ── Auth (CLAUDE.md §7.1) ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-me-with-a-48-byte-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-48-byte-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── Customer QR signing (CLAUDE.md §3.6, §7.9) ──────────────────────────────
# Separate from the JWT secrets: QR tokens are long-lived and opaque, never PII.
# Rotating this invalidates every printed/sent customer QR code — treat as permanent.
QR_TOKEN_SECRET="replace-me-with-another-48-byte-random-string"

# ── Merchant locale (period boundaries are computed in this zone) ───────────
MERCHANT_TIMEZONE="Asia/Baghdad"
MERCHANT_CURRENCY="IQD"

# ── Notifications (CLAUDE.md §3.5) ──────────────────────────────────────────
# `stub` logs messages instead of sending — the default for local development.
# `whatsapp` uses the Meta WhatsApp Business Cloud API (Phase 4).
NOTIFICATION_PROVIDER=stub
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Names of the pre-approved message templates (business-initiated sends require these).
WHATSAPP_TEMPLATE_WELCOME="walaa_welcome_ar"
WHATSAPP_TEMPLATE_TRANSACTION="walaa_transaction_linked_ar"
WHATSAPP_TEMPLATE_COUPON="walaa_coupon_issued_ar"

# ── Rate limiting (CLAUDE.md §7.5) ──────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"

# ── Dashboard (Next.js) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── Assistant (Expo) ────────────────────────────────────────────────────────
# Use the LAN IP of the API host when testing on a physical device.
EXPO_PUBLIC_API_URL="http://localhost:4000"
