# ─────────────────────────────────────────────────────────────────────────────
# Walaa — environment template. Copy to `.env` and fill in real values.
# NEVER commit a populated .env (see .gitignore). CLAUDE.md §7.6.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# v3: local SQLite file (CLAUDE_v3.md §5.1). Relative paths resolve from
# apps/api/prisma. In production this points at the OS app-data directory for
# the Windows Service account (§12.3).
DATABASE_URL="file:./walaa.db"

# ── API service ─────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated origins allowed to call the API.
#  tauri.localhost — the Tauri 2 webview origin (the manager desktop app)
#  localhost:5173  — the Vite dev server for the manager desktop UI
#  localhost:5174  — the Vite dev server for the Loyalty Station
#                    (in production the Station is served BY the API, same origin)
#  localhost:4000  — the Loyalty Station, which the API serves itself
# A LAN deployment may need the manager machine's own address added here.
API_CORS_ORIGINS="http://tauri.localhost,https://tauri.localhost,http://localhost:5173,http://localhost:5174,http://localhost:4000"
LOG_LEVEL=info

# ── Auth (CLAUDE.md §7.1) ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-me-with-a-48-byte-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-48-byte-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── Customer QR signing (CLAUDE.md §3.6, §7.9) ──────────────────────────────
# Separate from the JWT secrets: QR tokens are long-lived and opaque, never PII.
# Rotating this invalidates every printed/sent customer QR code — treat as permanent.
QR_TOKEN_SECRET="replace-me-with-another-48-byte-random-string"

# ── Merchant locale (period boundaries are computed in this zone) ───────────
MERCHANT_TIMEZONE="Asia/Baghdad"
MERCHANT_CURRENCY="IQD"

# ── Notifications (CLAUDE.md §3.5) ──────────────────────────────────────────
# `stub` logs messages instead of sending — the default for local development.
# `whatsapp` uses the Meta WhatsApp Business Cloud API (Phase 4).
NOTIFICATION_PROVIDER=stub
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Names of the pre-approved message templates (business-initiated sends require these).
WHATSAPP_TEMPLATE_WELCOME="walaa_welcome_ar"
WHATSAPP_TEMPLATE_TRANSACTION="walaa_transaction_linked_ar"
WHATSAPP_TEMPLATE_COUPON="walaa_coupon_issued_ar"

# ── Rate limiting (CLAUDE.md §7.5) ──────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"

# ── Backup (CLAUDE_v3.md §7.3, §12.18) ──────────────────────────────────────
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# READ THIS BEFORE SETTING IT: a key that exists only on the machine being backed
# up is not a backup. The failures backup survives — dead disk, theft, ransomware —
# take this file with them, and every archive then becomes permanently unopenable.
# Write it down and keep it off the machine. Unset means backup is not configured,
# which the dashboard says plainly rather than pretending.
BACKUP_KEY=""
# Defaults to <data dir>/backups on an installed machine
# (%PROGRAMDATA%\Walaa\backups), and to <repo>/.walaa-dev/backups in a checkout —
# a dev process is unelevated and cannot write under ProgramData, and a scheduled
# backup failing there every five minutes would make a 507 look like background noise.
BACKUP_LOCAL_DIR=""
# The removable drive of §7.3's third copy, e.g. E:\walaa-backups
BACKUP_USB_DIR=""
# Archives kept per destination.
BACKUP_KEEP=14

# ── Scheduling (§7.3: daily after close + every 500 transactions) ───────────
# Runs inside the API service, so it survives a closed manager window. A slot missed
# because the machine was off is run at next start rather than skipped — a till
# powered down overnight is normal, not exceptional.
BACKUP_SCHEDULE_ENABLED=true
# LOCAL wall-clock time in the merchant's timezone, not UTC. 23:30 UTC would be 02:30
# in Baghdad — the middle of the night on the wrong day.
BACKUP_DAILY_AT="23:30"
BACKUP_EVERY_TRANSACTIONS=500

# ── Google Drive, the off-machine copy (§7.3) ───────────────────────────────
# DEVELOPMENT AND TESTS ONLY. On a shop's machine (NODE_ENV=production) these are
# IGNORED: the owner enters the OAuth client in the manager app (Settings → Google
# Drive), where the secret is stored encrypted, and the refresh token comes from the
# in-app consent flow. A secret in this file would be a secret in a plain config
# file. Setup, step by step: packaging/GOOGLE-DRIVE-SETUP.md.
#
# Client id and secret must be set together or not at all. Scope is drive.file: this
# app can only ever see files it created itself, so GOOGLE_DRIVE_FOLDER_ID must name
# a folder THIS APP created, or be left empty.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""

# ── Dashboard (Next.js) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── Assistant (Expo) ────────────────────────────────────────────────────────
# Use the LAN IP of the API host when testing on a physical device.
EXPO_PUBLIC_API_URL="http://localhost:4000"
