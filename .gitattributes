# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

# Lockfiles and generated SQL are never hand-merged.
pnpm-lock.yaml linguist-generated=true -diff
apps/api/prisma/migrations/**/*.sql linguist-generated=true

# Vendored design exports are reference material, not authored source.
design/stitch/** linguist-vendored=true

# Binary — never touch line endings.
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
