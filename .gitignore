# dependencies
node_modules/
.pnpm-store/

# secrets — never commit real env files
.env
.env.*
!.env.example

# build output
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# prisma
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# test / coverage
coverage/

# Rust build output for the licensing crates, and the native module they produce.
crates/*/target/
tools/license-issuer/target/
packages/license-native/target/
packages/license-native/target-test/
packages/license-native/*.node
# The development issuer's log — local to whoever runs it.
tools/license-issuer/dev-key/issued.db

# SQLite database files — data, never source.
apps/api/prisma/*.db
apps/api/prisma/*.db-wal
apps/api/prisma/*.db-shm
# Backup snapshots and archives the test suite stages (it cleans up after itself; this
# catches an interrupted run, which would otherwise leave encrypted archives in the tree).
apps/api/prisma/test-backups-*/
apps/api/prisma/test-license-*/

# rust build output (tauri app shell, service host)
target/

# .NET build output (the Print Capture Agent)
[Bb]in/
[Oo]bj/

# Stitch design exports: the extracted directory is tracked (it is the reference the
# four surviving screens were built against, see CLAUDE_v3.md 12.26). The archive it came
# out of is a binary duplicate of it and is not.
stitch_wala_a_loyalty_management_dashboard.zip

# Dev-only backup destination. The installed service writes under %PROGRAMDATA%;
# a checkout writes here, because it cannot write there (see backup.service.ts).
.walaa-dev/

# Updater signing key — losing it means no shop can ever be updated again.
packaging/updater/*.key

# Scratch experiment drivers kept beside the package they probe. They are named with a
# leading underscore precisely so they never reach a commit: each one is a one-off
# harness for an experiment whose RESULT belongs in a test or a docblock, not a file
# nobody will run again.
apps/api/_*
apps/api/prisma/_*
apps/manager-desktop/uilab.*

# ── The updater signing key must never enter a commit ────────────────────────
#
# The private half signs updates that install on every machine running this product.
# It lives outside the repository entirely (see packaging/SIGNING.md), and these
# patterns exist so that a copy dropped in here by accident is refused rather than
# committed. `signing-key.test.ts` asserts the same thing from the other direction.
*.key
!**/node_modules/**/*.key
.walaa-signing/
walaa-updater.key*
TAURI_SIGNING*
