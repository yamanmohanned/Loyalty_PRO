# dependencies
node_modules/
.pnpm-store/

# secrets — never commit real env files
.env
.env.*
!.env.example

# build output
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# prisma
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# test / coverage
coverage/

# SQLite database files — data, never source.
apps/api/prisma/*.db
apps/api/prisma/*.db-wal
apps/api/prisma/*.db-shm
# Backup snapshots and archives the test suite stages (it cleans up after itself; this
# catches an interrupted run, which would otherwise leave encrypted archives in the tree).
apps/api/prisma/test-backups-*/

# rust build output (tauri app shell, service host)
target/

# .NET build output (the Print Capture Agent)
[Bb]in/
[Oo]bj/

# Stitch design exports: the extracted directory is tracked (it is the reference the
# four surviving screens were built against, see CLAUDE_v3.md 12.26). The archive it came
# out of is a binary duplicate of it and is not.
stitch_wala_a_loyalty_management_dashboard.zip

# Dev-only backup destination. The installed service writes under %PROGRAMDATA%;
# a checkout writes here, because it cannot write there (see backup.service.ts).
.walaa-dev/
