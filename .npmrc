# Hoist nothing implicitly — workspace packages must declare their own deps.
auto-install-peers=true

# ...and that intent has to be enforced for @types, because pnpm's default hoist
# pattern is `*`. Everything lands in `node_modules/.pnpm/node_modules/`, one version
# per package name wins, and TypeScript finds it while walking up from a dependency's
# own directory. This workspace holds React 18 (Station, manager desktop) and React 19
# (Next dashboard), so the winner decided which `React.ReactNode` `lucide-react` and
# `react-router-dom` were typed against — for every app, regardless of what that app
# declared.
#
# It broke the moment an unrelated package was deleted: removing the deprecated Expo
# app took its `@types/react@18` out of the running, React 19 won the hoist, and the
# Station stopped compiling with `TS2786: 'Route' cannot be used as a JSX component`.
# Nothing about that error points at a lockfile. Excluding @types from the hoist makes
# every app see the types it actually declares, which is what the line above claims.
hoist-pattern[]=*
hoist-pattern[]=!@types/*
strict-peer-dependencies=false
# Keep the lockfile authoritative in CI.
prefer-frozen-lockfile=true
