# Hoist nothing implicitly — workspace packages must declare their own deps.
auto-install-peers=true

# ...and that intent has to be enforced for @types, because pnpm's default hoist
# pattern is `*`. Everything lands in `node_modules/.pnpm/node_modules/`, one version
# per package name wins, and TypeScript finds it while walking up from a dependency's
# own directory. When this was written the workspace held React 18 (Station, manager
# desktop) AND React 19 (the Next dashboard), so the winner decided which
# `React.ReactNode` `lucide-react` and `react-router-dom` were typed against — for
# every app, regardless of what that app declared.
#
# ── The Next dashboard is gone (v4), and these two lines STAY ────────────────
#
# Only React 18 remains, so hoisting would currently give every package the right
# types and this exclusion looks like dead configuration. It is not, and the
# temptation to tidy it is now much stronger than it was — which is the reason this
# paragraph exists.
#
# Keep it because the failure it prevents is silent, arrives in a package nobody
# edited, and names a file nobody touched: §12.24's `TS2786` appeared when an
# unrelated app was DELETED. A second React version returns the first time anything
# is added with its own — the Expo app had one, the dashboard had one — and the
# person who adds it will not connect their change to a type error somewhere else.
# The exclusion costs nothing while there is one version and is already correct when
# there are two.
#
# It broke the moment an unrelated package was deleted: removing the deprecated Expo
# app took its `@types/react@18` out of the running, React 19 won the hoist, and the
# Station stopped compiling with `TS2786: 'Route' cannot be used as a JSX component`.
# Nothing about that error points at a lockfile. Excluding @types from the hoist makes
# every app see the types it actually declares, which is what the line above claims.
hoist-pattern[]=*
hoist-pattern[]=!@types/*
strict-peer-dependencies=false
# Keep the lockfile authoritative in CI.
prefer-frozen-lockfile=true
