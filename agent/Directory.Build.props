<Project>
  <!--
    Shared build settings for the Print Capture Agent.

    Warnings are errors on purpose. This component sits in a shop's print path
    (docs/legacy/CLAUDE_v3.md §4.6): a nullable-reference warning here is a NullReferenceException
    in the forwarding loop, and the consequence of that is a store that cannot print
    receipts.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
