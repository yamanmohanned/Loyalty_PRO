<?xml version="1.0" encoding="utf-8"?>
<!--
  The package cache lives on E:, not C:.

  This is the same relocation CLAUDE_v3.md §12.1 applied to TEMP, CARGO_HOME and
  RUSTUP_HOME, extended to .NET because the Print Capture Agent is the first component
  that needs it. It is not tidiness: the C: drive on the build machine is full — a
  restore against the default location fails outright with "There is not enough space
  on the disk", which is how this file came to exist.

  Committed rather than left to an environment variable so that a fresh clone builds
  without anyone having to know. The HTTP cache has no config equivalent and is
  disabled at the command line instead; see agent/README.md.
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="E:\nuget\packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
