{
  "expo": {
    "name": "ولاء — مساعد الكاشير",
    "slug": "walaa-assistant",
    "scheme": "walaa",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F8FA",
    "primaryColor": "#0F6E56",
    "locales": {},
    "extra": {
      "supportsRTL": true
    },
    "android": {
      "package": "com.walaa.assistant",
      "permissions": ["android.permission.CAMERA"]
    },
    "ios": {
      "bundleIdentifier": "com.walaa.assistant",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "الكاميرا مطلوبة لمسح رمز الزبون وباركود الفاتورة."
      }
    },
    "plugins": ["expo-localization"]
  }
}
