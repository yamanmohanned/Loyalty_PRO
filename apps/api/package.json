{
  "name": "@walaa/api",
  "version": "0.1.1-preview",
  "private": true,
  "description": "Walaa loyalty backend — Fastify service, Prisma data layer.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:verify": "tsx prisma/verify.ts",
    "db:template": "dotenv -e ../../.env -- tsx prisma/build-db-template.ts",
    "db:template:check": "dotenv -e ../../.env -- tsx prisma/build-db-template.ts --check",
    "db:reset-ceremony": "tsx prisma/reset-ceremony.ts",
    "restore": "tsx src/tools/restore-cli.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "dev": "tsx watch src/server.ts",
    "dev:alt": "dotenv -e ../../.env -v API_PORT=4001 -v API_CORS_ORIGINS=http://tauri.localhost,https://tauri.localhost,http://localhost:5173,http://localhost:5174,http://localhost:5180,http://localhost:4000 -- tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup src/server.ts --format esm --target node20 --clean",
    "db:seed:demo": "dotenv -e ../../.env -v WALAA_DATA_DIR=./prisma -v DATABASE_URL=file:./walaa-demo.db -- tsx prisma/seed-demo.ts && pnpm db:assert:demo",
    "db:assert:demo": "dotenv -e ../../.env -v WALAA_DATA_DIR=./prisma -v DATABASE_URL=file:./walaa-demo.db -v WALAA_DEMO=1 -- tsx prisma/assert-demo-migrated.ts && pnpm db:assert:login",
    "db:assert:login": "dotenv -e ../../.env -v WALAA_DATA_DIR=./prisma -v DATABASE_URL=file:./walaa-demo.db -v WALAA_DEMO=1 -- tsx prisma/assert-demo-login.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "@fastify/websocket": "^11.0.2",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.1",
    "@walaa/shared-types": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@walaa/config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
