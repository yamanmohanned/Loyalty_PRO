// ═══════════════════════════════════════════════════════════════════════════════
//  Loyalty Pro — v3 instant-discount data model
//  Authority: docs/legacy/CLAUDE_v3.md §5. Supersedes the v1 model in CLAUDE.md §4.
//
//  Three rules govern this file:
//
//   1. Every core table carries `merchantId`. Single merchant per installation
//      today; the isolation seam stays so multi-tenancy is not a rewrite.
//
//   2. Money is a whole-dinar Int. Never Float, never Decimal (§5.4).
//
//   3. **Aggregates are NEVER stored as a number** (§5.3). They are always
//      computed by summing `transaction` rows in the active period. The v1
//      `balance_snapshot` cache is deliberately gone: a stored aggregate drifts
//      from the log that produced it, and then silently lies. There is no
//      cache to reconcile because there is no cache.
//
//  ── SQLite notes (provider changed from PostgreSQL in V3-1) ──────────────────
//  SQLite does not support Prisma `enum`, `@db.Uuid`, or `Json`. Every former
//  enum is therefore a `String` whose permitted values are listed in a comment
//  above it and enforced at the boundary by Zod in `packages/shared-types`. The
//  database is not the validator here; the contract package is.
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Tenancy ───────────────────────────────────────────────────────────────────

model Merchant {
  id String @id @default(uuid())
  name String
  /// IANA zone the merchant trades in. Discount period boundaries are computed
  /// here, not in UTC — a 01:00 Baghdad sale must not fall in the previous period.
  timezone String @default("Asia/Baghdad")
  currency String @default("IQD")
  /// Thermal roll width in millimetres for the Loyalty Station's slip printer: 58 or
  /// 80. Merchant-level rather than per-station (§10.7): a shop running two roll
  /// widths is hypothetical, and a per-station setting is a real settings surface on
  /// an app that has none by design (§6.4).
  paperWidth Int @default(80) @map("paper_width")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches Branch[]
  users User[]
  customers Customer[]
  transactions Transaction[]
  discountRules DiscountRule[]
  discountSettings DiscountSettings?
  vouchers Voucher[]
  featureFlags FeatureFlag[]
  notificationLogs NotificationLog[]
  auditLogs AuditLog[]
  cards Card[]
  cardBatches CardBatch[]
  settingDrafts SettingDraft[]
  settingVersions SettingVersion[]

  @@map("merchant")
}

model Branch {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  name String
  /// Printed on receipts, e.g. "BAG-01". Unique within the merchant.
  code String
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  users User[]
  transactions Transaction[]

  @@unique([merchantId, code])
  @@index([merchantId])
  @@map("branch")
}

// ── Staff ─────────────────────────────────────────────────────────────────────

model User {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  /// Null for OWNER, who is not bound to a single branch.
  branchId String? @map("branch_id")
  name String
  username String
  /// Argon2id. Never a plaintext or reversible value.
  passwordHash String @map("password_hash")
  /// OWNER | MANAGER | STATION
  /// STATION is new in v3: the Loyalty Station operator account (§6.2). It may
  /// scan, register customers and print — and must never reach a settings screen.
  /// v1's ASSISTANT role is gone with the Expo app it belonged to.
  role String
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  linkedTransactions Transaction[] @relation("TransactionLinkedBy")
  redeemedVouchers Voucher[] @relation("VoucherRedeemedBy")
  auditLogs AuditLog[]
  updatedFlags FeatureFlag[] @relation("FeatureFlagUpdatedBy")
  assignedCards Card[] @relation("CardAssignedBy")
  generatedBatches CardBatch[] @relation("CardBatchGeneratedBy")
  updatedSettingDrafts SettingDraft[] @relation("SettingDraftUpdatedBy")
  publishedSettingVersions SettingVersion[] @relation("SettingVersionPublishedBy")

  @@unique([merchantId, username])
  @@index([merchantId, role])
  @@map("user")
}

/// Refresh tokens are revocable, so only their hash is stored. Rotation chains
/// via replacedById: reuse of a rotated token is a theft signal.
model RefreshToken {
  id String @id @default(uuid())
  userId String @map("user_id")
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  replacedById String? @map("replaced_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token")
}

// ── Customers ─────────────────────────────────────────────────────────────────

model Customer {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  name String
  /// E.164, normalised on write. The per-merchant unique constraint below only
  /// means anything because every write goes through that normalisation.
  phone String
  /// REGULAR | WHOLESALE | VIP
  category String @default("REGULAR")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  vouchers Voucher[]
  notificationLogs NotificationLog[]
  /// Every card this customer has ever held. At most one is ASSIGNED at a time,
  /// which the partial unique index in the migration enforces (§12.25).
  cards Card[]

  @@unique([merchantId, phone])
  @@index([merchantId, category])
  /// Hot path: phone lookup for card reprint at the station.
  @@index([phone])
  @@map("customer")
}

// ── Discount configuration ────────────────────────────────────────────────────

/// One tier of the discount ladder. Replaces v1's loyalty_rule_set + loyalty_tier
/// + customer_override_rule, all of which belonged to the deferred-coupon model.
model DiscountRule {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  /// The invoice amount at which this bracket starts — «قيمة الفاتورة». Whole IQD,
  /// inclusive: an invoice of exactly this much qualifies. v3 read it as cumulative
  /// spend across a period; v4 reads it as one invoice's total (§1.4). The column
  /// keeps its name deliberately — the §12.12 precedent.
  thresholdAmount Int @map("threshold_amount")
  /// PERCENTAGE | FIXED_AMOUNT
  discountType String @map("discount_type")
  /// Whole percent when PERCENTAGE; whole IQD when FIXED_AMOUNT.
  discountRate Int @map("discount_rate")
  /// Per-rule absolute ceiling in IQD, applied after any percentage calculation.
  /// Null defers to `discount_settings.absoluteMaxDiscountValue`.
  maxDiscountValue Int? @map("max_discount_value")
  isActive Boolean @default(true) @map("is_active")
  sortOrder Int @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  /// A repeated threshold would make "which tier applies" ambiguous.
  @@unique([merchantId, thresholdAmount])
  @@index([merchantId, isActive, sortOrder])
  @@map("discount_rule")
}

/// Singleton per merchant. Holds the guardrails from §2.3 that stop a
/// misconfiguration from costing the store more than the sale earns.
model DiscountSettings {
  id String @id @default(uuid())
  merchantId String @unique @map("merchant_id")
  /// PERCENTAGE | FIXED_AMOUNT | NONE — NONE disables instant discount entirely.
  discountType String @default("PERCENTAGE") @map("discount_type")
  /// Bounds the manager may configure a rule within. Whole percent.
  minRate Int @default(1) @map("min_rate")
  maxRate Int @default(3) @map("max_rate")
  /// ═══ THE LAST LINE OF DEFENCE (§2.3) ═══
  /// An absolute IQD ceiling applied after every percentage calculation. Category
  /// exclusions were explicitly declined by the merchant, so without this a
  /// 500,000 IQD basket at 10% gifts away 50,000 IQD on a ~2–4% net margin.
  /// A percentage discount must never ship without it.
  absoluteMaxDiscountValue Int @default(5000) @map("absolute_max_discount_value")
  /// v4 removed `period_type` / `period_start` / `period_end`: nothing accumulates,
  /// so there is no window to configure (docs/legacy/CLAUDE_UPDATE_4.md §1.3, §10.6).
  /// MERCHANT_DEFINED | VOUCHER_AS_PAYMENT | DAILY_PROMOTIONAL_EXPENSE (§9, closed).
  /// Chooses the wording of the cashier instruction printed on the slip, nothing else.
  /// Defaults to the strategy that states the figures and presumes no procedure; a
  /// store wanting an explicit one selects it in settings (§12.28).
  settlementStrategy String @default("MERCHANT_DEFINED") @map("settlement_strategy")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("discount_settings")
}

// ── The core loop ─────────────────────────────────────────────────────────────

model Transaction {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  branchId String @map("branch_id")
  /// NULLABLE, and this is the central v3 change. The Print Capture Agent records
  /// an invoice the moment it is printed — before any card is scanned, and often
  /// before a card ever is. An unattributed invoice is a normal, expected row.
  customerId String? @map("customer_id")
  /// The merchant's printed invoice number, as captured from the receipt.
  invoiceId String @map("invoice_id")

  /// Money, all whole IQD (§5.4). The POS's figure is authoritative: the loyalty
  /// system reads what the POS recorded and never computes a price (§0 rule 4).
  amountGross Int @map("amount_gross")
  /// PERCENTAGE | FIXED_AMOUNT | NONE
  discountType String @default("NONE") @map("discount_type")
  /// The configured rate that was applied, retained so a historical row can be
  /// explained after the rules change.
  discountRate Int @default(0) @map("discount_rate")
  /// Actual IQD discounted, AFTER the absolute cap. Zero when nothing was earned.
  discountValue Int @default(0) @map("discount_value")
  /// What the ladder called for BEFORE §2.3's absolute cap, a tier's own
  /// `maxDiscountValue`, or a basket smaller than the discount trimmed it.
  ///
  /// Equal to `discountValue` whenever nothing bound, so `uncapped > value` is the
  /// test for "the cap bit here" and the difference is what it saved. Persisted
  /// because §2.3's guardrails exist to protect the margin and a guardrail that
  /// never reports is a guardrail nobody can tune: if the cap binds on every
  /// qualifying sale, the tier ladder is set wrong and the manager needs to see
  /// that rather than discover it in the accounts (§12.37).
  discountUncappedValue Int @default(0) @map("discount_uncapped_value")
  /// amountGross - discountValue. Stored because it is what the customer pays and
  /// what reconciliation compares against; it is not an aggregate.
  amountNet Int @map("amount_net")
  currency String @default("IQD")

  /// SPOOL_WATCH | VIRTUAL_PRINTER | SERIAL_BRIDGE | NETWORK_PROXY | MANUAL
  captureMode String @map("capture_mode")
  /// v4 removed `period_key`. It existed to make "cumulative spend for one customer
  /// in the active period" an indexed equality lookup, and that question no longer
  /// exists: the discount comes from `amountGross` alone (§1.1, §10.6).

  /// When the POS printed it.
  occurredAt DateTime @map("occurred_at")
  /// When the agent intercepted the print job.
  capturedAt DateTime @map("captured_at")
  /// When a card scan attributed it to a customer. Null while unattributed.
  linkedAt DateTime? @map("linked_at")
  /// Which Loyalty Station performed the link.
  stationId String? @map("station_id")
  linkedByUserId String? @map("linked_by_user_id")
  /// Client-generated id for the ingestion attempt, so an agent retry after a
  /// dropped response is recognised as the same attempt rather than a new sale.
  idempotencyKey String? @unique @map("idempotency_key")
  createdAt DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  linkedBy User? @relation("TransactionLinkedBy", fields: [linkedByUserId], references: [id], onDelete: SetNull)
  vouchers Voucher[]

  /// ═══ THE IDEMPOTENCY GUARD (§4.8) ═══
  /// A re-sent capture — an agent network retry — must never create a second
  /// transaction. This constraint is the last line of defence behind the API
  /// check. If the API check is ever bypassed, the database still refuses.
  @@unique([merchantId, branchId, invoiceId])
  @@index([branchId, invoiceId])
  @@index([customerId])
  @@index([merchantId, occurredAt])
  /// Unattributed invoices awaiting a card scan.
  @@index([merchantId, customerId, capturedAt])
  @@map("transaction")
}

/// An issued discount slip. Exists so the paper the cashier collects can be
/// reconciled against system records at end of day, under either settlement
/// strategy (§9). Redemption is a state transition, never a delete.
model Voucher {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  transactionId String @map("transaction_id")
  customerId String @map("customer_id")
  /// Short human-readable code printed on the slip for the cashier to match.
  code String @map("code")
  /// IQD discounted. Mirrors transaction.discountValue at issue time.
  value Int
  /// VOUCHER_AS_PAYMENT | DAILY_PROMOTIONAL_EXPENSE — which strategy issued it,
  /// recorded per voucher so a settings change does not retroactively reinterpret
  /// slips already in the cash drawer.
  settlementStrategy String @map("settlement_strategy")
  /// ISSUED | REDEEMED | VOID
  status String @default("ISSUED")
  issuedAt DateTime @default(now()) @map("issued_at")
  redeemedAt DateTime? @map("redeemed_at")
  redeemedByUserId String? @map("redeemed_by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  redeemedBy User? @relation("VoucherRedeemedBy", fields: [redeemedByUserId], references: [id], onDelete: SetNull)

  @@unique([merchantId, code])
  /// One discount slip per invoice. Two would double-discount a single sale and
  /// open a cash-vs-POS gap — the failure §0 rule 3 forbids outright.
  @@unique([transactionId])
  @@index([customerId])
  @@index([status])
  @@index([merchantId, status, issuedAt])
  @@map("voucher")
}

// ── Modularity ────────────────────────────────────────────────────────────────

/// Optional modules check a flag before rendering or executing (§8). Toggled from
/// manager settings — no code changes, no separate builds, one binary for every
/// merchant.
model FeatureFlag {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  /// whatsapp_integration | customer_card_printing | cloud_backup |
  /// advanced_reports | voucher_reconciliation | sms_fallback | auto_update
  key String
  isEnabled Boolean @default(false) @map("is_enabled")
  updatedByUserId String? @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("FeatureFlagUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([merchantId, key])
  @@index([merchantId])
  @@map("feature_flag")
}

// NOTE: §5.2's `sync_queue` is deliberately NOT a table here. It is described as
// "local to Station and Agent only" — the Station keeps it in browser storage and
// the Agent in its own local store. Adding it to the manager's database would
// invert the design: the queue exists precisely for when the manager is
// unreachable. Do not create one here.

// ── Observability ─────────────────────────────────────────────────────────────

model NotificationLog {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  customerId String @map("customer_id")
  /// WHATSAPP | SMS
  channel String @default("WHATSAPP")
  /// Name of the pre-approved template used. Business-initiated WhatsApp messages
  /// cannot be free-form. Optional module — gated by the whatsapp_integration flag.
  template String
  /// Template variables only, JSON-encoded. SQLite has no Json type, so this is a
  /// String and callers serialize explicitly. Never tokens, never credentials.
  payload String
  /// PENDING | SENT | FAILED | STUBBED
  status String @default("PENDING")
  sentAt DateTime? @map("sent_at")
  error String?
  createdAt DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@index([customerId])
  @@map("notification_log")
}

/// Append-only. Rows are never updated or deleted.
model AuditLog {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  /// Null for system actions such as a scheduled backup.
  actorUserId String? @map("actor_user_id")
  action String
  entityType String @map("entity_type")
  entityId String @map("entity_id")
  /// JSON-encoded strings — see the NotificationLog.payload note on SQLite.
  beforeJson String? @map("before_json")
  afterJson String? @map("after_json")
  createdAt DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt])
  @@index([entityType, entityId])
  /// The trail is also the backup history and the key-ceremony record (§12.19, §12.21),
  /// and every one of those reads filters by `action`. Without this they walk the
  /// merchant's whole trail: the Backup screen scans backwards past every scan of every
  /// day since the last successful backup, and the scheduler's dueness check does the
  /// same every five minutes. Both get slower in exact proportion to how long backups
  /// have been broken — the query degrades precisely in the case it exists to reveal.
  @@index([merchantId, action, createdAt])
  @@map("audit_log")
}

// ── Physical card stock (§12.25) ──────────────────────────────────────────────
//
// Cards exist BEFORE customers do. A batch is generated, a vendor prints it, and
// the cards sit in a drawer as PRINTED until somebody is handed one.
//
// The card number lives here and not on `customer` for one reason: a customer holds
// several cards over a lifetime, and a REPLACED card has to stay rejectable *by
// number* long after it stopped being anybody's card. A number on the customer row
// can only ever describe the current card, so the old one becomes unrepresentable —
// which is exactly the state a person who found it would exploit.
//
// Two guarantees in this file are NOT expressible in Prisma and live in the
// migration SQL instead. Read them there before changing anything here:
//
//   * `card_one_active_per_customer` — a partial unique index over
//     (merchant_id, customer_id) WHERE status = 'ASSIGNED'. One live card per
//     customer, kept by the database rather than remembered by code.
//   * CHECK constraints tying status to ownership and origin to serial, so a row
//     that contradicts itself cannot be written at all.

model Card {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  /// Human-readable serial printed large on a pre-printed card: 1 → `000042`.
  /// NULL for THERMAL cards — they are printed on demand and there is no physical
  /// stock to track. Letting them consume serials would corrupt the count of blanks
  /// remaining, which is the number the batch screen exists to answer.
  serial Int?
  /// The sixteen digits the barcode carries, stored bare.
  /// PRE_PRINTED: a six-digit serial then a ten-digit HMAC check (`card.v2`).
  /// THERMAL: ten random digits then a six-digit truncated HMAC (`card.v1`).
  /// Both are 16 digits of Code 128C — 143 modules, unchanged since §12.12.
  cardNumber String @map("card_number")
  /// `card.v1` | `card.v2` — which scheme signed this number. Stored rather than
  /// inferred: the two are indistinguishable by shape, and a verifier that guessed
  /// would have to try both on every scan forever.
  scheme String
  /// PRE_PRINTED | THERMAL
  origin String
  /// PRINTED | ASSIGNED | LOST | REPLACED | VOID
  status String @default("PRINTED")
  batchId String? @map("batch_id")
  /// NULL while the card is blank stock or a misprint. Kept after LOST and
  /// REPLACED, because who held a dead card is what a support call asks about.
  customerId String? @map("customer_id")
  assignedAt DateTime? @map("assigned_at")
  assignedByUserId String? @map("assigned_by_user_id")
  lostAt DateTime? @map("lost_at")
  /// The card that superseded this one. One-to-one: a card replaces at most one.
  replacedByCardId String? @unique @map("replaced_by_card_id")
  voidedAt DateTime? @map("voided_at")
  voidReason String? @map("void_reason")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  batch CardBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("CardAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  replacedBy Card? @relation("CardReplacement", fields: [replacedByCardId], references: [id], onDelete: SetNull)
  replaces Card? @relation("CardReplacement")

  /// The hard guarantee against overlapping batch ranges. A batch's range is not a
  /// claim to be validated — every serial in it is a row, so a second batch covering
  /// the same numbers fails on INSERT, not on a check somebody could forget to write.
  @@unique([merchantId, serial])
  @@unique([merchantId, cardNumber])
  /// Scan hot path: the station resolves a scanned number to a card on every sale.
  @@index([cardNumber])
  /// The batch screen's per-status tallies, and "how many blanks are left".
  @@index([merchantId, status])
  @@index([batchId, status])
  @@index([customerId])
  @@map("card")
}

model CardBatch {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  /// Sequential per merchant from 1. What the merchant calls the batch out loud.
  batchNumber Int @map("batch_number")
  /// Inclusive. Derived from the rows that exist, never chosen by a human: the
  /// merchant picks the QUANTITY and the server picks the start, which is what
  /// removes the collision he is worried about instead of warning him about it.
  serialStart Int @map("serial_start")
  serialEnd Int @map("serial_end")
  quantity Int
  /// GENERATED | EXPORTED | RECEIVED | RETIRED
  status String @default("GENERATED")
  note String?
  generatedByUserId String? @map("generated_by_user_id")
  generatedAt DateTime @default(now()) @map("generated_at")
  exportedAt DateTime? @map("exported_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  generatedBy User? @relation("CardBatchGeneratedBy", fields: [generatedByUserId], references: [id], onDelete: SetNull)
  cards Card[]

  @@unique([merchantId, batchNumber])
  @@index([merchantId, generatedAt])
  @@map("card_batch")
}

/// Every licence code activated on this installation (packaging/LICENSING.md).
///
/// The status is never read from these columns. The Rust licensing module re-verifies
/// each stored `code` on every check and chooses the governing licence from the codes
/// themselves; the other columns are the Settings screen's history, and editing them
/// changes nothing but that list. No relations, deliberately: a licence belongs to the
/// machine, and must survive whatever happens to merchant or user rows.
model LicenseActivation {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  /// The code's `lid`. One row per licence, so pasting the same code twice is a no-op.
  licenseId String @unique @map("license_id")
  /// trial | perpetual
  kind String
  deviceId String @map("device_id")
  issuedAt DateTime @map("issued_at")
  /// NULL for a perpetual licence.
  expiresAt DateTime? @map("expires_at")
  /// JSON array of feature names, copied from the code for display.
  features String
  note String?
  /// The code as activated, whitespace removed. The only column the status reads.
  code String
  activatedAt DateTime @default(now()) @map("activated_at")
  activatedByUserId String? @map("activated_by")

  @@index([merchantId, activatedAt])
  @@map("license_activation")
}

/// One row (id = 1): this installation's identity and the database's copy of the
/// clock anchor.
model InstallationState {
  id Int @id
  /// Computed once, on first start, and kept: a replaced drive changes the computed
  /// value, and the rule is a warning in the audit trail, never a revoked licence.
  deviceId String @map("device_id")
  /// SHA-256 digests of the two sources — enough to say which one changed, without
  /// storing the machine GUID or the volume serial.
  machineGuidDigest String @map("machine_guid_digest")
  volumeSerialDigest String @map("volume_serial_digest")
  deviceComputedAt DateTime @map("device_computed_at")
  /// The latest time this installation has observed. One of three anchors; the other
  /// two are in the registry and a hidden file, and the latest of the three wins.
  lastSeenAt DateTime? @map("last_seen_at")
  /// The last status the licence check produced, and until when it holds (NULL for
  /// PERPETUAL). What the gate falls back to when the check itself fails — so a bug or
  /// a missing module never stops a shop that was licensed.
  lastStatus String? @map("last_status")
  lastStatusUntil DateTime? @map("last_status_until")
  lastStatusAt DateTime? @map("last_status_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("installation_state")
}

/// Every emergency code entered here — the fifteen symbols the provider reads over the
/// phone (crates/loyalty-pro-license/src/unlock.rs). Like licence codes, re-verified on every
/// check; `valid_until` is for the history list.
model LicenseUnlock {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  code String @unique
  deviceId String @map("device_id")
  validUntil DateTime @map("valid_until")
  enteredAt DateTime @default(now()) @map("entered_at")
  enteredByUserId String? @map("entered_by")

  @@map("license_unlock")
}

// ── Settings engine (PRD §4, FND-04) ──────────────────────────────────────────

/// The working copy of one layer's settings, before anybody has agreed to it.
///
/// §4 requires «مسودة ثم معاينة ثم نشر»: a manager edits, sees the effect, and only
/// then commits it. A draft is therefore mutable and has no history — it is the thing
/// being typed. Everything durable lives in `setting_version`.
///
/// One row per (merchant, scope, scopeId). `scopeId` is null for MERCHANT and the
/// station id for STATION; SQLite treats each NULL as distinct in a UNIQUE index, so
/// the merchant row is kept unique by the partial constraint in the migration rather
/// than by this one alone.
model SettingDraft {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  /// MERCHANT | STATION. SYSTEM is the registry in code and is never stored.
  scope String
  scopeId String? @map("scope_id")
  /// Only the keys this layer overrides. Absent means "inherit", which is not the
  /// same as any value — storing the full resolved set would freeze today's defaults
  /// into every shop and silently ignore a later change to them.
  values String
  updatedByUserId String? @map("updated_by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("SettingDraftUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([merchantId, scope, scopeId])
  @@index([merchantId, scope])
  @@map("setting_draft")
}

/// A published set of settings. Append-only: the live values are the highest version.
///
/// §4 requires «إمكانية الرجوع إلى إصدار سابق». Rolling back COPIES an old version
/// forward as a new one rather than deleting what came after, for the same reason the
/// loyalty ledger is append-only: the question a shop owner asks three weeks later is
/// «what was it set to when this went wrong», and a history that rewrites itself
/// cannot answer it. It also makes rollback ordinary — it is just another publish, so
/// it audits, versions and resolves exactly like one.
model SettingVersion {
  id String @id @default(uuid())
  merchantId String @map("merchant_id")
  scope String
  scopeId String? @map("scope_id")
  /// Sequential per (merchant, scope, scopeId) from 1.
  version Int
  values String
  /// What the manager called this publish, so two are distinguishable in a list.
  note String?
  /// Set when this version was produced by rolling back to an earlier one.
  rolledBackFrom Int? @map("rolled_back_from")
  publishedByUserId String? @map("published_by_user_id")
  publishedAt DateTime @default(now()) @map("published_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  publishedBy User? @relation("SettingVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@unique([merchantId, scope, scopeId, version])
  @@index([merchantId, scope, scopeId, version])
  @@map("setting_version")
}
