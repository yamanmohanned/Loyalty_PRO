{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loyalty",
  "version": "0.1.0",
  "identifier": "com.loyaltypro.manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ولاء — إدارة المتجر",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' http: https: ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "publisher": "Customer loyalty",
    "copyright": "© 2026",
    "category": "Business",
    "shortDescription": "Loyalty Pro — منصة الولاء والمتجر وإدارة الطلبات",
    "longDescription": "Loyalty Pro — لوحة تحكم لإدارة الرحلة والمنتجات والمتجر الإلكتروني والطلبات والزبائن والتقارير.",
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "",
      "nsis": {
        "languages": [
          "Arabic",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./nsis/hooks.nsh"
      }
    },
    "resources": {
      "../../../packaging/dist/runtime": "runtime"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": false,
      "pubkey": "",
      "endpoints": [
        "https://github.com/yamanmohanned/Loyalty_PRO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
