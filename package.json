{
  "name": "walaa",
  "version": "0.1.0",
  "private": true,
  "description": "Supermarket Loyalty Platform (ولاء) — monorepo root",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:wait": "docker compose exec -T postgres pg_isready -U walaa -d walaa",
    "db:migrate": "pnpm --filter @walaa/api db:migrate",
    "db:generate": "pnpm --filter @walaa/api db:generate",
    "db:seed": "pnpm --filter @walaa/api db:seed",
    "db:reset": "pnpm --filter @walaa/api db:reset",
    "db:studio": "pnpm --filter @walaa/api db:studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
