{
  "name": "@walaa/config",
  "version": "0.1.1-preview",
  "private": true,
  "description": "Shared TypeScript / ESLint / Tailwind presets and design tokens.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./tailwind-preset": "./tailwind/preset.cjs",
    "./eslint": "./eslint/base.cjs",
    "./tsconfig/*": "./tsconfig/*"
  },
  "files": [
    "src",
    "tsconfig",
    "eslint",
    "tailwind"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@eslint/js": "^9.18.0",
    "typescript-eslint": "^8.20.0",
    "globals": "^15.14.0"
  }
}
