{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Walaa React Native (Expo) app",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "declaration": false,
    "declarationMap": false
  }
}
