# ولاء — إعدادات الخدمة. يُنشأ هذا الملف تلقائياً عند التثبيت.
# Generated per installation by `walaa-service.exe install`. Do not commit a filled copy.
#
# ── This is a data file, and that is deliberate ──────────────────────────────
#
# It used to be a literal array inside `stage.mjs`. Nothing could read it but the
# script that wrote it, so nothing could check it — and the thing worth checking is
# that every setting the API *requires* appears here. A required setting added to the
# schema and forgotten here does not fail the build, or the tests, or the developer's
# machine: it fails on a merchant's first launch, as a service that refuses to start.
#
# `src/__tests__/env-contract.test.ts` now asserts exactly that against this file, and
# `stage.mjs` copies it rather than generating it.
#
# `{{PLACEHOLDER}}` values are substituted by `walaa-service.exe install`, which
# generates 48 random bytes for each secret so no two shops share a signing key.

NODE_ENV=production

# Filled in by `walaa-service.exe install` with the name THIS build opens: walaa.db for
# production, walaa-demo.db for a demo. The two never share a file.
DATABASE_URL="file:{{DATABASE_FILE}}"
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info

# Generated at install time — 48 random bytes each.
JWT_ACCESS_SECRET={{JWT_ACCESS_SECRET}}
JWT_REFRESH_SECRET={{JWT_REFRESH_SECRET}}
QR_TOKEN_SECRET={{QR_TOKEN_SECRET}}

MERCHANT_TIMEZONE=Asia/Baghdad
MERCHANT_CURRENCY=IQD
NOTIFICATION_PROVIDER=stub

# The Tauri webview, plus the LAN address the Loyalty Station browses to.
# The installer appends the machine address; add others by hand if a second
# station is set up on a different subnet.
API_CORS_ORIGINS="http://tauri.localhost,https://tauri.localhost,http://localhost:4000"
